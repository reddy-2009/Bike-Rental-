# fRESCA Bike Rentals — environment
# Copy this file to `.env` in the repository root (or backend/.env).
# Shell variables take priority over values set here.

# development | production
NODE_ENV=development

# API port (Vite proxies /api to this port during development)
PORT=4000

# Bind address. 0.0.0.0 allows phones on the same Wi-Fi to reach the app.
# Use 127.0.0.1 to restrict it to this laptop only.
HOST=0.0.0.0

# Optional: move the SQLite file elsewhere.
# DATABASE_PATH=C:\Users\you\data\fresca.db

# Required in production. Generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# ---------------------------------------------------------------------------
# Admin dashboard + website customisation
# ---------------------------------------------------------------------------

# Password for the Admin Access gate on the sign-in page. The default when this
# is unset is 9989. The value is hashed into the database on startup; the
# environment variable stays authoritative and is never sent to the browser.
# ADMIN_ACCESS_PASSWORD=9989
# ADMIN_ACCESS_EMAIL=navaneethreddychagari1005@gmail.com

# ---------------------------------------------------------------------------
# Mobile OTP (registration, phone verification and password recovery)
# ---------------------------------------------------------------------------

# 1 = return the sandbox OTP in the API response so local testing works without
# an SMS provider. 0 = real SMS only (or a clear 503 when no provider is set).
# Never enable this on a public production deployment.
OTP_DEV_MODE=1

# 2factor | msg91 | twilio (leave empty until you have an account)
# SMS_PROVIDER=2factor
# SMS_API_KEY=
# SMS_SENDER_ID=FRESCA
# Required by some Indian providers for transactional templates:
# SMS_TEMPLATE_ID=

# Twilio alternative
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# ---------------------------------------------------------------------------
# Payments (all optional — the built-in simulator is used when keys are absent)
# ---------------------------------------------------------------------------

# Public HTTPS origin used to build gateway return/webhook URLs.
# Example: https://fresca.example.com
# PUBLIC_BASE_URL=

# 1 = show PhonePe/Paytm even without merchant keys (simulator mode).
# 0 = hide any gateway that has no credentials.
PAYMENTS_SIMULATOR=1

# --- PhonePe (PG Standard Checkout v2) -------------------------------------
# PHONEPE_CLIENT_ID=
# PHONEPE_CLIENT_SECRET=
# PHONEPE_CLIENT_VERSION=1
# sandbox | production
# PHONEPE_ENV=sandbox
# Refund API endpoint from your PhonePe merchant dashboard. Without it, a
# rejection/cancellation is recorded as Refund Failed — Admin Action Required.
# PHONEPE_REFUND_URL=
# Optional basic-auth credentials expected on /api/payments/webhook/phonepe
# PHONEPE_WEBHOOK_USER=
# PHONEPE_WEBHOOK_PASSWORD=

# --- Paytm (hosted checkout) ----------------------------------------------
# PAYTM_MID=
# PAYTM_MERCHANT_KEY=
# WEBSTAGING while testing; your live website code in production.
# PAYTM_WEBSITE=WEBSTAGING
# PAYTM_INDUSTRY_TYPE=Retail
# PAYTM_CHANNEL_ID=WEB
# staging | production
# PAYTM_ENV=staging
# Refund API endpoint from Paytm. Without it, rejected/cancelled bookings are
# marked Refund Failed — Admin Action Required instead of pretending to refund.
# PAYTM_REFUND_URL=
