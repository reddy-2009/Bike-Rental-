# fRESCA Bike Rentals - environment
# Copy this file to `.env` in the repository root (or backend/.env).
# Shell variables take priority over values set here.

# development | production
NODE_ENV=development

# API port (Vite proxies /api to this port during development)
PORT=4000

# Bind address. 0.0.0.0 allows phones on the same Wi-Fi to reach the app.
# Use 127.0.0.1 to restrict it to this laptop only.
HOST=0.0.0.0

# Optional: move the SQLite file elsewhere.
# DATABASE_PATH=C:\Users\you\data\fresca.db

# Required in production. The server refuses to start with NODE_ENV=production
# unless this is a unique value of at least 32 characters, so a forged admin
# session is impossible. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Development falls back to a local-only secret when this is unset.
# JWT_SECRET=

# ---------------------------------------------------------------------------
# Admin dashboard + website customisation
# ---------------------------------------------------------------------------

# Password for the Admin Access gate on the sign-in page. The default when this
# is unset is 9989, but NODE_ENV=production refuses to start until a unique
# password is set. The value is hashed into the database on startup; the
# environment variable stays authoritative and is never sent to the browser.
# ADMIN_ACCESS_PASSWORD=9989
# ADMIN_ACCESS_EMAIL=navaneethreddychagari1005@gmail.com

# ---------------------------------------------------------------------------
# Supabase (backend only)
# ---------------------------------------------------------------------------

# Used by @supabase/server for server-side queries and JWT verification.
# The publishable key is safe for clients. The secret key bypasses Row Level
# Security, so keep it server-side and never expose it through a VITE_ or
# PUBLIC_ variable.
SUPABASE_URL=https://jgvunoetpbprazdukywg.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Optional today: only supabaseAdmin() needs it, and no route calls that yet.
# Copy a new secret key from Project Settings > API Keys, then revoke the old
# key in the dashboard. Deleting the value here does not revoke a leaked key.
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Direct Postgres connection. Percent-encode special characters in the
# password (for example @ becomes %40). Keep it server-side.
SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require

# Mirror ledger. SQLite stays authoritative and the real payment ledger is
# copied to Supabase: users, bikes, bookings, payments and refunds. Set
# SUPABASE_LEDGER=0 to turn it off. The interval is a full safety reconcile;
# individual changes are queued immediately.
SUPABASE_LEDGER=1
SUPABASE_CA_PATH=prisma/supabase-ca.crt
SUPABASE_LEDGER_INTERVAL_MS=60000

# ---------------------------------------------------------------------------
# Prisma
# ---------------------------------------------------------------------------
# Both URLs need the same database password, percent-encoded. DATABASE_URL is
# the transaction pooler used by the app at runtime. DIRECT_URL is the direct
# connection used by the Prisma CLI for migrate and db pull. The direct host is
# IPv6 only; on an IPv4-only network use the session pooler string from the
# dashboard. Copy the exact pooler host from Supabase Dashboard > Connect.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require"

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
# The card form is a sandbox demo and is only available outside production.
# In production the checkout offers configured gateways only; there is no
# fallback that can mark a booking paid without a real capture.

# Public HTTPS origin used to build gateway return/webhook URLs. Live
# production gateways require this: set it to the exact public origin, for
# example https://fresca.example.com, and terminate TLS in front of Express.
# PUBLIC_BASE_URL=https://fresca.example.com

# 1 = show PhonePe/Paytm simulators without merchant keys (development only).
# Default: 1 outside production, 0 in production. Never enable in production.
# PAYMENTS_SIMULATOR=1

# Return URLs given to the gateways are built automatically:
#   PhonePe return  ${PUBLIC_BASE_URL}/api/payments/return/phonepe
#   Paytm   return  ${PUBLIC_BASE_URL}/api/payments/return/paytm
# Webhooks registered in the merchant dashboards:
#   PhonePe webhook ${PUBLIC_BASE_URL}/api/payments/webhook/phonepe
#   Paytm   webhook ${PUBLIC_BASE_URL}/api/payments/webhook/paytm

# --- PhonePe (PG Standard Checkout v2) -------------------------------------
# PHONEPE_CLIENT_ID=
# PHONEPE_CLIENT_SECRET=
# PHONEPE_CLIENT_VERSION=1
# sandbox | production
# PHONEPE_ENV=sandbox
# Optional override. By default the app calls the PG v2 refund endpoint:
#   sandbox     https://api-preprod.phonepe.com/apis/pg-sandbox/payments/v2/refund
#   production  https://api.phonepe.com/apis/pg/payments/v2/refund
# PHONEPE_REFUND_URL=
# SHA webhook credentials configured on the PhonePe dashboard. PhonePe sends
# the hex SHA-256 digest of username:password in the Authorization header.
# Strongly recommended for live payments so only PhonePe can trigger a check.
# PHONEPE_WEBHOOK_USER=
# PHONEPE_WEBHOOK_PASSWORD=

# --- Paytm (hosted checkout) ----------------------------------------------
# PAYTM_MID=
# PAYTM_MERCHANT_KEY=
# Must be exactly 16 bytes. The official checksum uses AES-128-CBC with the
# fixed IV @@@@&&&&####$$$$ and a SHA-256 hash plus 4-character salt.
# WEBSTAGING while testing; your live website code in production.
# PAYTM_WEBSITE=WEBSTAGING
# PAYTM_INDUSTRY_TYPE=Retail
# PAYTM_CHANNEL_ID=WEB
# staging | production
# PAYTM_ENV=staging
# Refund API endpoint from Paytm. Without it, rejected/cancelled bookings are
# marked Refund Failed - Admin Action Required instead of pretending to refund.
# PAYTM_REFUND_URL=
