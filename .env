# ---------------------------------------------------------------------------
# Supabase (backend only)
# ---------------------------------------------------------------------------

# Project URL and publishable key. The publishable key is safe to use in
# clients; the secret key below bypasses Row Level Security and must never be
# sent to the browser or committed.
SUPABASE_URL=https://jgvunoetpbprazdukywg.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_BTkh0kzc6Jnz96Eq6MypfQ_0q3GnsWB

# Required for supabaseAdmin() and auth: 'secret'. Copy the real value from
# Supabase Dashboard > Project Settings > API Keys. Never expose this key to
# the browser or commit it.
# Removed on 2026-11-10: the app never calls supabaseAdmin(), so no server
# secret key is needed at runtime. To enable it later, create a new secret key
# in the Supabase dashboard (Project Settings > API Keys), then add a line:
# SUPABASE_SECRET_KEY=sb_secret_...

# Used by auth: 'user' to verify Supabase access tokens.
SUPABASE_JWKS_URL=https://jgvunoetpbprazdukywg.supabase.co/auth/v1/.well-known/jwks.json

# Postgres connection (server only). Read by @supabase/server's Postgres
# middleware; it also needs `pg`. Uses the dedicated prisma role over the
# IPv4 session pooler because the direct host is IPv6 only on this network.
SUPABASE_DB_URL=postgresql://prisma.jgvunoetpbprazdukywg:1ZgBXOC85paytcJz@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# Prisma
# ---------------------------------------------------------------------------
# DATABASE_URL is the transaction pooler used by the app at runtime.
# DIRECT_URL is the session pooler used by Prisma CLI commands such as
# migrate and db pull. The direct host db.<project-ref>.supabase.co is IPv6
# only, so both strings use the IPv4 shared pooler.
DATABASE_URL="postgresql://prisma.jgvunoetpbprazdukywg:1ZgBXOC85paytcJz@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://prisma.jgvunoetpbprazdukywg:1ZgBXOC85paytcJz@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# Supabase signs the shared pooler certificate with its own root CA. The
# Prisma Client uses prisma/supabase-ca.crt to verify TLS. Refresh that file
# from Database Settings > SSL Configuration if Supabase rotates the CA.

# The live Railway deployment is now the single writer for the Supabase mirror.
# Two databases mirroring into the same tables collide on unique keys, so this
# laptop stays a local-only copy. Remove this line to mirror from here again,
# but only after the live service sets SUPABASE_LEDGER=0.
SUPABASE_LEDGER=0
